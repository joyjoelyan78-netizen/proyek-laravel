

/* ================= DETAIL PRODUK ================= */

.detail-produk-page{
    padding: 120px 40px 80px;

    background: #f8fafc;

    min-height: 100vh;
}

.detail-container{
    max-width: 1350px;

    margin: 0 auto;

    display: grid;
    grid-template-columns: 520px 1fr;

    gap: 50px;

    align-items: start;
}

/* IMAGE */
.detail-image-box{
    background: white;

    border-radius: 18px;

    padding: 25px;

    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.detail-image-box img{
    width: 100%;
    height: 520px;

    object-fit: contain;

    border-radius: 14px;
}

/* CONTENT */
.detail-content{
    background: white;

    border-radius: 18px;

    padding: 40px;

    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

/* CATEGORY */
.detail-kategori{
    display: inline-block;

    padding: 8px 18px;

    background: #dbeafe;

    color: #1d4ed8;

    border-radius: 999px;

    font-size: 13px;
    font-weight: 600;

    margin-bottom: 20px;
}

/* TITLE */
.detail-content h1{
    font-size: 42px;

    line-height: 1.2;

    margin-bottom: 18px;

    color: #0f172a;
}

/* CODE */
.detail-kode{
    color: #64748b;

    margin-bottom: 30px;

    font-size: 15px;
}

/* DESCRIPTION */
.detail-deskripsi{
    font-size: 16px;

    line-height: 1.9;

    color: #475569;

    margin-bottom: 35px;
}

/* SPEC */
.detail-spec{
    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 16px;

    padding: 25px;

    margin-bottom: 35px;
}

.detail-spec h3{
    margin-bottom: 20px;

    font-size: 22px;

    color: #0f172a;
}

.detail-spec table{
    width: 100%;
}

.detail-spec tr{
    border-bottom: 1px solid #e2e8f0;
}

.detail-spec tr:last-child{
    border-bottom: none;
}

.detail-spec td{
    padding: 14px 0;

    font-size: 15px;
}

.detail-spec td:first-child{
    width: 40%;

    color: #64748b;

    font-weight: 600;
}

.detail-spec td:last-child{
    color: #0f172a;

    font-weight: 500;
}

/* BUTTON */
.detail-wa-btn{
    display: inline-flex;

    align-items: center;
    gap: 12px;

    padding: 16px 30px;

    background: #22c55e;

    color: white;

    text-decoration: none;

    border-radius: 12px;

    font-size: 16px;
    font-weight: 600;

    transition: 0.3s;

    box-shadow: 0 10px 20px rgba(34,197,94,0.2);
}

.detail-wa-btn:hover{
    background: #16a34a;

    transform: translateY(-3px);
}

/* RESPONSIVE */
@media(max-width: 1000px){

    .detail-container{
        grid-template-columns: 1fr;
    }

    .detail-content h1{
        font-size: 34px;
    }

}

@media(max-width: 768px){

    .detail-produk-page{
        padding: 100px 20px 60px;
    }

    .detail-content{
        padding: 25px;
    }

    .detail-image-box img{
        height: 350px;
    }

    .detail-content h1{
        font-size: 28px;
    }

}

/* LINK PRODUK */
.produk-link{
    text-decoration: none;
    color: inherit;

    display: block;
}

.tracking-page{
    width:100%;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#f5f5f5;
}

.tracking-card{
    width:500px;
    background:#fff;
    border-radius:14px;
    padding:30px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.tracking-header{
    text-align:center;
    margin-bottom:25px;
}

.tracking-header h2{
    font-size:28px;
    margin-bottom:10px;
}

.tracking-card input{
    width:100%;
    height:50px;
    border:1px solid #ddd;
    border-radius:10px;
    padding:0 15px;
    margin-top:10px;
    margin-bottom:20px;
}

.tracking-card button{
    width:100%;
    height:50px;
    border:none;
    border-radius:10px;
    background:#111827;
    color:white;
    font-weight:bold;
}

.timeline{
    margin-top:40px;
}

.timeline-item{
    display:flex;
    gap:20px;
    margin-bottom:30px;
}

.timeline-dot{
    width:18px;
    height:18px;
    border-radius:50%;
    background:#2563eb;
    margin-top:5px;
}

.timeline-content{
    background:#fff;
    width:100%;
    padding:20px;
    border-radius:12px;
    box-shadow:0 5px 15px rgba(0,0,0,.05);
}

.detail-produk{
    padding:80px 8%;
}

.detail-wrapper{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:start;
}

.detail-gambar img{
    width:100%;
    border-radius:20px;
    box-shadow:0 15px 30px rgba(0,0,0,.15);
}

.detail-info h1{
    font-size:42px;
    margin-bottom:15px;
}

.detail-info p{
    color:#555;
    line-height:1.8;
    margin-bottom:25px;
}

.kategori{
    display:inline-block;
    background:#2563eb;
    color:white;
    padding:6px 14px;
    border-radius:30px;
    margin-bottom:15px;
}

.spesifikasi{
    width:100%;
    border-collapse:collapse;
    margin-bottom:30px;
}

.spesifikasi td{
    padding:12px;
    border-bottom:1px solid #ddd;
}

.btn-wa{
    display:inline-block;
    background:#22c55e;
    color:white;
    text-decoration:none;
    padding:14px 25px;
    border-radius:12px;
    font-weight:600;
}

.btn-wa:hover{
    opacity:.9;
}

@media(max-width:900px){

    .detail-wrapper{
        grid-template-columns:1fr;
    }

}

#chatbot-toggle{
    position:fixed;
    bottom:25px;
    right:25px;

    width:65px;
    height:65px;

    border-radius:50%;

    background:#2563eb;
    color:white;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:30px;

    cursor:pointer;

    z-index:9999;

    box-shadow:0 10px 25px rgba(0,0,0,.2);
}

#chatbot-box{
    position:fixed;

    bottom:100px;
    right:25px;

    width:350px;
    height:500px;

    background:white;

    border-radius:20px;

    display:none;
    flex-direction:column;

    overflow:hidden;

    z-index:9999;

    box-shadow:0 15px 40px rgba(0,0,0,.2);
}

.chat-header{
    background:#2563eb;
    color:white;

    padding:15px;

    font-weight:700;
}

#chat-messages{
    flex:1;

    padding:15px;

    overflow-y:auto;

    color:#111827;
}

.chat-input{
    display:flex;

    border-top:1px solid #e5e7eb;
}

.chat-input input{
    flex:1;

    border:none;

    padding:12px;
}

.chat-input button{
    border:none;

    background:#2563eb;
    color:white;

    padding:12px 16px;

    cursor:pointer;
}

/* ==========================
   CHATBOT
========================== */

#chatbot-toggle{
    position:fixed;
    right:25px;
    bottom:25px;

    width:65px;
    height:65px;

    border-radius:50%;
    background:#0d6efd;

    display:flex;
    justify-content:center;
    align-items:center;

    color:white;
    font-size:28px;

    cursor:pointer;

    z-index:9999;

    box-shadow:
    0 0 20px rgba(13,110,253,.5);

    transition:.3s;
}

#chatbot-toggle:hover{
    transform:scale(1.1);
}

#chatbot-box{

    position:fixed;

    right:25px;
    bottom:100px;

    width:380px;
    height:550px;

    background:white;

    border-radius:20px;

    overflow:hidden;

    display:none;
    flex-direction:column;

    z-index:9999;

    box-shadow:
    0 10px 35px rgba(0,0,0,.25);

    animation:chatShow .3s ease;
}

@keyframes chatShow{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

.chat-header{

    background:#0d6efd;
    color:white;

    padding:18px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    font-weight:600;
}

.chat-title{
    display:flex;
    gap:10px;
    align-items:center;
}

#close-chat{
    cursor:pointer;
}

#chat-messages{

    flex:1;

    padding:15px;

    overflow-y:auto;

    background:#f5f7fb;
}

.user-message{

    background:#0d6efd;
    color:white;

    padding:10px 15px;

    border-radius:15px 15px 0 15px;

    margin-bottom:12px;

    max-width:80%;

    margin-left:auto;
}

.bot-message{

    background:white;

    padding:10px 15px;

    border-radius:15px 15px 15px 0;

    margin-bottom:12px;

    max-width:80%;

    box-shadow:
    0 2px 8px rgba(0,0,0,.08);
}

.chat-input{

    display:flex;

    border-top:1px solid #eee;
}

.chat-input input{

    flex:1;

    border:none;

    padding:15px;

    outline:none;
}

.chat-input button{

    width:60px;

    border:none;

    background:#0d6efd;

    color:white;

    cursor:pointer;
}

.chat-input button:hover{
    background:#0b5ed7;
}

/* loading animation */

.typing{

    background:white;

    width:70px;

    padding:12px;

    border-radius:15px;

    display:flex;
    gap:5px;
}

.typing span{

    width:8px;
    height:8px;

    background:#999;

    border-radius:50%;

    animation:typing 1s infinite;
}

.typing span:nth-child(2){
    animation-delay:.2s;
}

.typing span:nth-child(3){
    animation-delay:.4s;
}

@keyframes typing{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-5px);
    }
}

#chatbot-box{

    position:fixed;
    right:25px;
    bottom:100px;

    width:380px;
    height:550px;

    background:white;
    border-radius:20px;

    overflow:hidden;

    display:flex;
    flex-direction:column;

    z-index:9999;

    box-shadow:
    0 10px 35px rgba(0,0,0,.25);

    opacity:0;
    visibility:hidden;

    transform:translateY(30px) scale(.95);

    transition:
    opacity .3s ease,
    transform .3s ease,
    visibility .3s ease;
}

/* Saat dibuka */
#chatbot-box.show{

    opacity:1;
    visibility:visible;

    transform:
    translateY(0)
    scale(1);
}

#chatbot-toggle{

    animation:
    pulse 2s infinite;
}

@keyframes pulse{

    0%{
        box-shadow:
        0 0 0 0
        rgba(13,110,253,.7);
    }

    70%{
        box-shadow:
        0 0 0 18px
        rgba(13,110,253,0);
    }

    100%{
        box-shadow:
        0 0 0 0
        rgba(13,110,253,0);
    }
}